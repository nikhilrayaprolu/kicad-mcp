[{"tool":"project_open","args":{"path":"designs/rv1106-sbc","create":true,"name":"rv1106_sbc",
  "description":"LP-1106: Linux SBC on Rockchip RV1106G3 (Cortex-A7, 1 TOPS NPU, 256MB DDR3L in package). USB-C power+OTG, 10/100 Ethernet, SPI NAND boot, microSD, 2-lane MIPI CSI, debug UART, 2x10 GPIO.",
  "requirements":["5V from USB-C (sink, 5.1k Rd), reverse-current Schottky to VSYS",
   "Rails per RV1106 DS Table 3-2: VDD_0V9 0.81-0.95V, VCC_DDR 1.283-1.45V (DDR3L), VCC_1V8 1.62-1.98V, VCC_3V3 3.0-3.465V",
   "Sequencing like Luckfox reference: 0.9V first, then DDR+1.8V (RC delay), then 3.3V",
   "4-layer JLC 7628 stackup, single-sided assembly, In1=GND plane",
   "Boot from SPI NAND (FSPI), microSD on SDMMC0, console UART2_M1 115200"]}},
 {"tool":"blocks_list"},
 {"tool":"block_add","args":{"block":"usb_c_sink","params":{"block":"power","vbus":"VBUS","dp":"USB_DP","dm":"USB_DM","esd":true}}},
 {"tool":"ir_edit","args":{"ops":[
   {"op":"add_part","part":"D_SOD123F","block":"power","conn":{"A":"VBUS","K":"VSYS"},"note":"VBUS->VSYS Schottky (ref D1)"},
   {"op":"add_part","part":"C0805","block":"power","value":"22u/10V","conn":{"1":"VSYS","2":"GND"}},
   {"op":"add_part","part":"C0402","block":"power","value":"100n","conn":{"1":"VSYS","2":"GND"}},
   {"op":"add_part","part":"C0603","block":"power","value":"2.2u/10V","conn":{"1":"VBUS","2":"GND"}}]}},
 {"tool":"block_add","args":{"block":"buck_tlv62569","params":{"block":"power","vin":"VSYS","vout_net":"VDD_0V9","vout":0.9,"iout":1.2}}},
 {"tool":"block_add","args":{"block":"buck_tlv62569","params":{"block":"power","vin":"VSYS","vout_net":"VCC_DDR","vout":1.35,"en":"DDR_1V8_EN","soft_start_rc":true,"iout":0.4}}},
 {"tool":"block_add","args":{"block":"buck_tlv62569","params":{"block":"power","vin":"VSYS","vout_net":"VCC_1V8","vout":1.8,"en":"DDR_1V8_EN","iout":0.5}}},
 {"tool":"block_add","args":{"block":"buck_tlv62569","params":{"block":"power","vin":"VSYS","vout_net":"VCC_3V3","vout":3.3,"en":"EN_3V3","iout":0.8}}},
 {"tool":"block_add","args":{"block":"resistor","params":{"block":"power","a":"VSYS","b":"EN_3V3","value":"200k"}}},
